vious_Classification  \"10.120.30.40^Chemotaxis\",", "is", "plosthes.2017-1#"], ["status  \"Accepted\"", "is", "plosthes.2017-1#"], [" plosthes.2017-1#9567", "is", "Individual"], ["Previous_Classification  \"10.350.10.50^Drug addiction|60.250.210.20^Drug addiction|60.410.160.20^Drug addiction|110.90.10.50^Drug addiction\",", "is", "plosthes.2017-1#"], ["status  \"Accepted\"", "is", "plosthes.2017-1#"], [" plosthes.2017-1#9568", "is", "Individual"], ["Previous_Classification  \"10.240.30.230.50^Microsequencing|90.250.230.50^Microsequencing\",", "is", "plosthes.2017-1#"], ["status  \"Accepted\"", "is", "plosthes.2017-1#"], [" plosthes.2017-1#956", "is", "Individual"], ["External_Link  \"http", "is", "plosthes.2017-1#"], ["Previous_Classification  \"10.40.90.40.10^Electronic cigarettes|10.350.10.70.10^Electronic cigarettes|60.250.210.40.10^Electronic cigarettes|60.410.160.40.10^Electronic cigarettes|110.90.10.70.10^Electronic cigarettes\",", "is", "plosthes.2017-1#"], ["Synopsis_DBPedia  \"An electronic cigarette (e-cig or e-cigarette), personal vaporizer (PV) or electronic nicotine delivery system (ENDS) is a battery-powered vaporizer which has a similar feel to tobacco smoking. Electronic cigarettes do not contain tobacco, although they do use nicotine from tobacco plants. They do not produce cigarette smoke but rather an aerosol, which is frequently but inaccurately referred to as vapor. In general, they have a heating element that atomizes a liquid solution known as e-liquid.\",", "is", "plosthes.2017-1#"], ["status  \"Accepted\"", "is", "plosthes.2017-1#"], [" plosthes.2017-1#9570", "is", "Individual"], ["Previous_Classification  \"50.150.100.10.20^Protective footwear|60.410.140.20.10.20^Protective footwear\",", "is", "plosthes.2017-1#"], ["status  \"Accepted\"", "is", "plosthes.2017-1#"], [" plosthes.2017-1#9571", "is", "Individual"], ["Previous_Classification  \"60.350.190.60^Toxoplasmosis\",", "is", "plosthes.2017-1#"], ["status  \"Accepted\"", "is", "plosthes.