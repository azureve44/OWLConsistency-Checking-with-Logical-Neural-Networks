], [" Plagas", "is", "Class"], [" Plagas", "SubClassOf", "Afecciones"], [" Plaguicidas", "is", "Class"], ["Thing", "is", "www.w3.org/2002/07/#"], [" Recomendaciones", "is", "Class"], ["Thing", "is", "www.w3.org/2002/07/#"], [" Sintomas", "is", "Class"], ["Thing", "is", "www.w3.org/2002/07/#"], [" www.w3.org/2002/07/#", "is", "Class"], [" Aplicaci\u00f3n1", "is", "Individual"], [" Aplicaci\u00f3n1", "Types", "Aplicaci\u00f3n"], [" Aplicaci\u00f3n1", "se_debe_aplicar", "Banzai,"], [" Aplicaci\u00f3n1", "se_debe_aplicar", "Borey,"], [" Aplicaci\u00f3n1", "descipci\u00f3n", "\"Aplicar en cuanto aparezcan un 20% da\u00f1o\""], [" Aplicaci\u00f3n10", "is", "Individual"], [" Aplicaci\u00f3n10", "Types", "Aplicaci\u00f3n"], [" Aplicaci\u00f3n10", "se_debe_aplicar", "Solvendazim,"], [" Aplicaci\u00f3n10", "descipci\u00f3n", "\"Aplicar en cuanto aparezcan los primeros s\u00edntomas, generalmente a los 35 d\u00edas.\""], [" Aplicaci\u00f3n11", "is", "Individual"], [" Aplicaci\u00f3n11", "Types", "Aplicaci\u00f3n"], [" Aplicaci\u00f3n11", "se_debe_aplicar", "Prelude,"], [" Aplicaci\u00f3n11", "descipci\u00f3n", "\"Aplicar entre los 55 y 65 d\u00edas.\""], [" Aplicaci\u00f3n12", "is", "Individual"], [" Aplicaci\u00f3n12", "Types", "Aplicaci\u00f3n"], [" Aplicaci\u00f3n12", "se_debe_aplicar", "Fungis_Khan,"], [" Aplicaci\u00f3n12", "se_debe_aplicar", "Nomad,"], [" Aplicaci\u00f3n12", "descipci\u00f3n", "\"Aplicar a los 35 y 65 d\u00edas\""], [" Aplicaci\u00f3n14", "is", "Individual"], [" Aplicaci\u00f3n14", "Types", "Aplicaci\u00f3n"], [" Aplicaci\u00f3n14", "se_debe_aplicar", "Bolido,"], [" Aplicaci\u00f3n14", "se_debe_aplicar", "Sensei,"], [" Aplicaci\u00f3n14", "descipci\u00f3n", "\"La aplicaci\u00f3n ser\u00e1 dirigida al lugar donde se encuentra el insecto, al mismo tiempo se fumigar\u00e1 el suelo cubriendo el ancho de la corona alrededor de la planta que es el lugar que donde se encuentran las hormigas.\""], [" Aplicaci\u00f3n15", "is", "Individual"], [" Aplicaci\u00f3n15", "Types", "Aplicaci\u00f3n"], [" Aplicaci\u00f3n15", "se_debe_aplicar", "Courage,"], [" Aplicaci\u00f3n15", "descipci\u00f3n", "\"El momento de control es en estadio L1 y L2 pasado esta etapa se dificulta su control debido a que forma una especie de cuerno que lo protege.\""], [" Aplicaci\u00f3n16", "is", "Individual"], [" Aplicaci\u00f3n16", "Types", "Aplicaci\u00f3n"], [" Aplicaci\u00f3n16", "se_debe_aplicar", "Borey,"], [" Aplicaci\u00f3n16", "se_debe_aplicar", "Dimethoato,"], [" Aplicaci\u00f3n16", "se_debe_aplicar", "Lorsban,"], [" Aplicaci\u00f3n16", "descipci\u00f3n", "\"El control debe ser dirigido a destruir el hormiguero donde se encuentran la reina.\""], [" Aplicaci\u00f3n17", "is", "Individual"], [" Aplicaci\u00f3n17", "Types", "Aplicaci\u00f3n"], [" Aplicaci\u00f3n17", "se_debe_aplicar", "Ausato,"], [" Aplicaci\u00f3n17", "se_debe_aplicar", "Borrator,"], [" Aplicaci\u00f3n17", "descipci\u00f3n", "\"La aplicaci\u00f3n de herbicidas se debe iniciar en la entrada del invierno, en \u00e9poca seca es conveniente regar la plantaci\u00f3n uno o dos d\u00edas antes. Se aplican en malezas en activo crecimiento de preferencia cuando est\u00e1n entre 10 a 20 cm de altura.\""], [" Aplicaci\u00f3n18", "is", "Individual"], [" Aplicaci\u00f3n18", "Types", "Aplicaci\u00f3n"], [" Aplicaci\u00f3n18", "se_debe_aplicar", "Dacapo,"], [" Aplicaci\u00f3n18", "se_debe_aplicar", "Prelude,"], [" Aplicaci\u00f3n18", "descipci\u00f3n", "\"Regular la humedad y el sombr\u00edo dentro de la plantaci\u00f3n. Corte y quemado de plantas y ramas enfermas efectuar cirug\u00eda en areas afectadas oportunamente.\""], [" Aplicaci\u00f3n19", "is", "Individual"], [" Aplicaci\u00f3n19", "Types", "Aplicaci\u00f3n"], [" Aplicaci\u00f3n19", "se_debe_aplicar", "Corbat,"], [" Aplicaci\u00f3n19", "descipci\u00f3n", "\"Aplicaci\u00f3n de fungicidas de forma dirigida cada 15 a 21 d\u00edas en los meses de mayor precipitacion (Enero-Abril).\""], [" Aplicaci\u00f3n2", "is", "Individual"], [" Aplicaci\u00f3n2", "Types", "Aplicaci\u00f3n"], [" Aplicaci\u00f3n2", "se_debe_aplicar", "Courage,"], [" Aplicaci\u00f3n2", "se_debe_aplicar", "Sensei,"], [" Aplicaci\u00f3n2", "descipci\u00f3n", "\"Aplicar en cuanto aparezcan los primeros s\u00edntomas de da\u00f1o.\""], [" Aplicaci\u00f3n20", "is", "Individual"], [" Aplicaci\u00f3n20", "Types", "Aplicaci\u00f3n"], [" Aplicaci\u00f3n20", "se_debe_aplicar", "Benlate,"], [" Aplicaci\u00f3n20", "se_debe_aplicar", "Caldo_Bord\u00e9s,"], [" Aplicaci\u00f3n20", "se_debe_aplicar", "Daconilc,"], [" Aplicaci\u00f3n20", "se_debe_aplicar", "Difolat\u00e1n,"], [" Aplicaci\u00f3n20", "se_debe_aplicar", "Hidroxido_de_cobre,"], [" Aplicaci\u00f3n20", "se_debe_aplicar", "Oxicloruro_de_cobre,"], [" de 3 a 5 aplicaciones a partir de la entrada de las lluvias con intervalos de 30 d\u00edas\"", "is", "descipci\u00f3n  \"Manejo Integrado"], [" Aplicaci\u00f3n3", "is", "Individual"], [" Aplicaci\u00f3n3", "Types", "Aplicaci\u00f3n"], [" Aplicaci\u00f3n3", "se_debe_aplicar", "Basudin,"], [" Aplicaci\u00f3n3", "se_debe_aplicar", "Dimecroa,"], [" Aplicaci\u00f3n3", "se_debe_aplicar", "Lebaycid,"], [" Aplicaci\u00f3n3", "descipci\u00f3n", "\"Aplicar directamente en el hormiguero\""], [" Aplicaci\u00f3n4", "is", "Individual"], [" Aplicaci\u00f3n4", "Types", "Aplicaci\u00f3n"], [" Aplicaci\u00f3n4", "se_debe_aplicar", "Diabolo,"], [" Aplicaci\u00f3n4", "descipci\u00f3n", "\"Aplicar cuando exista una poblaci\u00f3n de 2 chinches/m2\""], [" Aplicaci\u00f3n5", "is", "Individual"], [" Aplicaci\u00f3n5", "Types", "Aplicaci\u00f3n"], [" Aplicaci\u00f3n5", "se_debe_aplicar", "Butasol,"], [" Aplicaci\u00f3n5", "se_debe_aplicar", "Paroli,"], [" Aplicaci\u00f3n5", "descipci\u00f3n", "\"Pre-emergencia\""], [" Aplicaci\u00f3n6", "is", "Individual"], [" Aplicaci\u00f3n6", "Types", "Aplicaci\u00f3n"], [" Aplicaci\u00f3n6", "se_debe_aplicar", "Bacanok,"], [" Aplicaci\u00f3n6", "descipci\u00f3n", "\"Aplicar en post emergencia temprana y tardia hasta los 45 d\u00edas del cultivo\""], [" Aplicaci\u00f3n7", "is", "Individual"], [" Aplicaci\u00f3n7", "Types", "Aplicaci\u00f3n"], [" Aplicaci\u00f3n7", "se_debe_aplicar", "Chekan,"], [" Aplicaci\u00f3n7", "descipci\u00f3n", "\"Aplicar en post emergencia temprana entre 12 y 25 d\u00edas de cultivo.\""], [" Aplicaci\u00f3n8", "is", "Individual"], [" Aplicaci\u00f3n8", "Types", "Aplicaci\u00f3n"], [" Aplicaci\u00f3n8", "se_debe_aplicar", "Rock,"], [" Aplicaci\u00f3n8", "descipci\u00f3n", "\"Pre y post emergencia temprana.\""], [" Aplicaci\u00f3n9", "is", "Individual"], [" Aplicaci\u00f3n9", "Types", "Aplicaci\u00f3n"], [" Aplicaci\u00f3n9", "se_debe_aplicar", "Limpast,"], [" Aplicaci\u00f3n9", "se_debe_aplicar", "Metsufozell,"], [" Aplicaci\u00f3n9", "descipci\u00f3n", "\"Aplicar en post emergencia temprana.\""], [" Arroz", "is", "Individual"], [" Arroz", "Types", "Cultivos"], [" Arroz", "clima", "\"Se trata de un cultivo tropical y subtropical, tambi\u00e9n se puede cultivar en las regiones h\u00famedas de los subtropicos y en climas templados.\","], [" Arroz", "nombre_cient\u00edfico", "\"Oryza sativa\""], [" Ausato", "is", "Individual"], [" Ausato", "Types", "Herbicidas"], [" Ausato", "es_tratamiento_de", "Caminadora,"], [" Ausato", "es_tratamiento_de", "Gramalote,"], [" Ausato", "es_tratamiento_de", "Guarda_rocio,"], [" Ausato", "es_tratamiento_de", "Paja_Brava,"], [" Ausato", "es_tratamiento_de", "Pata_de_gallina,"], [" Ausato", "se_debe_aplicar", "Aplicaci\u00f3n17,"], [" Ausato", "su_dosis_es", "Dosis24"], [" Bacanok", "is", "Individual"], [" Bacanok", "Types", "Herbicidas"], [" Bacanok", "es_tratamiento_de", "Chekan,"], [" Bacanok", "es_tratamiento_de", "Gramineas,"], [" Bacanok", "se_debe_aplicar", "Aplicaci\u00f3n6,"], [" Bacanok", "su_dosis_es", "Dosis7"], [" Banzai", "is", "Individual"], [" Banzai", "Types", "Pesticidas"], [" Banzai", "es_tratamiento_de", "Mosca_minadora,"], [" Banzai", "se_debe_aplicar", "Aplicaci\u00f3n1,"], [" Banzai", "su_dosis_es", "Dosis1"], [" Barrenadores", "is", "Individual"], [" Barrenadores", "Types", "Plagas"], [" Barrenadores", "afecta_a", "Arroz,"], [" Barrenadores", "su_tratamiento_es", "Courage,"], [" Barrenadores", "sus_sintomas_son", "Sintoma1,"], [" Barrenadores", "sus_sintomas_son", "Sintoma6,"], [" Barrenadores", "descipci\u00f3n", "\"\","], [" Barrenadores", "nombre_cient\u00edfico", "\"Rupela Albinella\""], [" Basudin", "is", "Individual"], [" Basudin", "Types", "Pesticidas"], [" Basudin", "es_tratamiento_de", "Escamas,"], [" Basudin", "se_debe_aplicar", "Aplicaci\u00f3n3,"], [" Basudin", "su_dosis_es", "Dosis16"], [" Batatilla", "is", "Individual"], [" Batatilla", "Types", "Malezas"], [" Batatilla", "afecta_a", "Cacao,"], [" Batatilla", "afecta_a", "Caf\u00e9,"], [" Batatilla", "su_tratamiento_es", "Borrator,"], [" Batatilla", "sus_sintomas_son", "Sintoma12,"], [" Batatilla", "descipci\u00f3n", "\"Bejuco perenne, herb\u00e1ceo, trepador o rastrero, de 10 m de largo o m\u00e1s. Ra\u00edz tuberosa, similar a un tub\u00e9rculo y algunas fibrosas. \","], [" Batatilla", "nombre_cient\u00edfico", "\"Ipomea congesta\""], [" Benlate", "is", "Individual"], [" Benlate", "Types", "Fungicidas"], [" Benlate", "es_tratamiento_de", "Mancha_de_Hierro,"], [" Benlate", "se_debe_aplicar", "Aplicaci\u00f3n20,"], [" Benlate", "su_dosis_es", "Dosis20"], [" Bledo", "is", "Individual"], [" Bledo", "Types", "Malezas"], [" Bledo", "afecta_a", "Cacao,"], [" Bledo", "afecta_a", "Caf\u00e9,"], [" Bledo", "su_tratamiento_es", "Borrator,"], [" Bledo", "sus_sintomas_son", "Sintoma12,"], [" Bledo", "descipci\u00f3n", "\"Estas malezas ocasionan otro problema de mayor gravedad, el gran antagonismo que ofrecen al desarrollo del cultivo, no solo desde el punto de vista de la competencia por agua, luz o nutrientes, sino porque muchas de ellas segregan substancias toxicas\","], [" Bledo", "nombre_cient\u00edfico", "\"Amarenthus dubius\""], [" Bolido", "is", "Individual"], [" Bolido", "Types", "Pesticidas"], [" Bolido", "es_tratamiento_de", "Cochinilla_harinosa,"], [" Bolido", "se_debe_aplicar", "Aplicaci\u00f3n14,"], [" Bolido", "su_dosis_es", "Dosis25"], [" Borey", "is", "Individual"], [" Borey", "Types", "Pesticidas"], [" Borey", "es_tratamiento_de", "Hormiga_Azteca,"], [" Borey", "es_tratamiento_de", "Mosca_minadora,"], [" Borey", "se_debe_aplicar", "Aplicaci\u00f3n1,"], [" Borey", "su_dosis_es", "Dosis1"], [" Borrator", "is", "Individual"], [" Borrator", "Types", "Herbicidas"], [" Borrator", "es_tratamiento_de", "Batatilla,"], [" Borrator", "es_tratamiento_de", "Bledo,"], [" Borrator", "es_tratamiento_de", "Lechosa,"], [" Borrator", "es_tratamiento_de", "Pega_Pega,"], [" Borrator", "es_tratamiento_de", "Siempreviva,"], [" Borrator", "se_debe_aplicar", "Aplicaci\u00f3n17,"], [" Borrator", "su_dosis_es", "Dosis23"], [" Broca_del_cafe", "is", "Individual"], [" Broca_del_cafe", "Types", "Enfermedades"], [" Broca_del_cafe", "afecta_a", "Caf\u00e9,"], [" Broca_del_cafe", "su_tratamiento_es", "Oxicloruro_de_cobre,"], [" Broca_del_cafe", "sus_sintomas_son", "Sintoma16,"], [" Broca_del_cafe", "descipci\u00f3n", "\"Es la plaga m\u00e1s importante en plantaciones comerciales de caf\u00e9 en pr\u00e1cticamente todos los pa\u00edses productores del mundo. Todas las variedades y especies comerciales de caf\u00e9 son atacadas por este insecto.\","], [" Broca_del_cafe", "nombre_cient\u00edfico", "\"Hypothenemus hampei Ferrari \""], [" Butasol", "is", "Individual"], [" Butasol", "Types", "Herbicidas"], [" Butasol", "es_tratamiento_de", "Hoja_angosta,"], [" Butasol", "se_debe_aplicar", "Aplicaci\u00f3n5,"], [" Butasol", "su_dosis_es", "Dosis6"], [" Cacao", "is", "Individual"], [" Cacao", "Types", "Cultivos"], [" Cacao", "clima", "\"El cacao se desarrolla en temperatura entre los 22 grados y los 30 grados Cent\u00edgrados. Este rango de temperatura permite al cacao tener un buen desarrollo vegetativo y dar cosechas abundantes.\","], [" Cacao", "nombre_cient\u00edfico", "\"Theobroma cacao\""], [" Caf\u00e9", "is", "Individual"], [" Caf\u00e9", "Types", "Cultivos"], [" Caf\u00e9", "clima", "\"Los cambios bruscos en la temperatura o temperaturas mayores a 25\u00b0C pueden tener efectos negativos sobre la plantaci\u00f3n.\","], [" Caf\u00e9", "nombre_cient\u00edfico", "\"Coffea\""], [" Caldo_Bord\u00e9s", "is", "Individual"], [" Caldo_Bord\u00e9s", "Types", "Fungicidas"], [" Caldo_Bord\u00e9s", "es_tratamiento_de", "La_roya,"], [" Caldo_Bord\u00e9s", "se_debe_aplicar", "Aplicaci\u00f3n20,"], [" Caldo_Bord\u00e9s", "su_dosis_es", "Dosis19"], [" Caminadora", "is", "Individual"], [" Caminadora", "Types", "Malezas"], [" Caminadora", "afecta_a", "Cacao,"], [" Caminadora", "afecta_a", "Caf\u00e9,"], [" Caminadora", "su_tratamiento_es", "Ausato,"], [" Caminadora", "sus_sintomas_son", "Sintoma12,"], [" Caminadora", "descipci\u00f3n", "\"Las malezas o arvenses son especies vegetales que crecen junto con el cultivo y compiten por el espacio, nutrientes y luz\","], [" Caminadora", "nombre_cient\u00edfico", "\"Rottboella exaltata\""], [" Chekan", "is", "Individual"], [" Chekan", "Types", "Herbicidas"], [" Chekan", "es_tratamiento_de", "Gramineas,"], [" Chekan", "se_debe_aplicar", "Aplicaci\u00f3n7,"], [" Chekan", "su_dosis_es", "Dosis8"], [" Chinche_de_la_espiga", "is", "Individual"], [" Chinche_de_la_espiga", "Types", "Plagas"], [" Chinche_de_la_espiga", "afecta_a", "Arroz,"], [" Chinche_de_la_espiga", "su_tratamiento_es", "Diabolo,"], [" Chinche_de_la_espiga", "sus_sintomas_son", "Sintoma5,"], [" Chinche_de_la_espiga", "descipci\u00f3n", "\"Este insecto afecta al arroz en su etapa de producci\u00f3n y llenado del grano mediante su estilete. Basta decir que el grano se encuentra a\u00fan en estado lechoso.\","], [" Chinche_de_la_espiga", "nombre_cient\u00edfico", "\"Oebalus ornatus\""], [" Chinche_del_cacao", "is", "Individual"], [" Chinche_del_cacao", "Types", "Plagas"], [" Chinche_del_cacao", "afecta_a", "Cacao,"], [" Chinche_del_cacao", "su_tratamiento_es", "Diabolo,"], [" Chinche_del_cacao", "sus_sintomas_son", "Sintoma20,"], [" Chinche_del_cacao", "sus_sintomas_son", "Sintoma21,"], [" Chinche_del_cacao", "sus_sintomas_son", "Sintoma5,"], [" Chinche_del_cacao", "descipci\u00f3n", "\"El da\u00f1o es causado por el chinche llamado Monalonion dissimulatum. Los da\u00f1os se localizan a nivel de brotes y frutos y en casos severos la picadura puede comprometer los granos de la mazorca. \","], [" Chinche_del_cacao", "nombre_cient\u00edfico", "\"Monalonium dissimulatum\""], [" Cochinilla_harinosa", "is", "Individual"], [" Cochinilla_harinosa", "Types", "Plagas"], [" Cochinilla_harinosa", "afecta_a", "Cacao,"], [" Cochinilla_harinosa", "su_tratamiento_es", "Bolido,"], [" Cochinilla_harinosa", "su_tratamiento_es", "Sensei,"], [" Cochinilla_harinosa", "sus_sintomas_son", "Sintoma1,"], [" Cochinilla_harinosa", "sus_sintomas_son", "Sintoma14,"], [" Cochinilla_harinosa", "sus_sintomas_son", "Sintoma22,"], [" Cochinilla_harinosa", "descipci\u00f3n", "\"Se denomina al insecto como un picador chupador ya que se alimenta de la savia de los brotes y ramas succionando estos jugos con su estilete.\","], [" Cochinilla_harinosa", "nombre_cient\u00edfico", "\"Pseudococcus citri\""], [" Complejo_manchado_del_grano", "is", "Individual"], [" Complejo_manchado_del_grano", "Types", "Enfermedades"], [" Complejo_manchado_del_grano", "afecta_a", "Arroz,"], [" Complejo_manchado_del_grano", "su_tratamiento_es", "Fungis_Khan,"], [" Complejo_manchado_del_grano", "su_tratamiento_es", "Nomad,"], [" Complejo_manchado_del_grano", "sus_sintomas_son", "Sintoma8,"], [" Complejo_manchado_del_grano", "descipci\u00f3n", "\"El grano manchado es causado por un complejo fungoso y bacteriano. El da\u00f1o causado es irreversible, alcanzando p\u00e9rdidas en la producci\u00f3n cuando la incidencia es alta\","], [" Complejo_manchado_del_grano", "nombre_cient\u00edfico", "\"Helminthosporium Oryzae\""], [" Corbat", "is", "Individual"], [" Corbat", "Types", "Fungicidas"], [" Corbat", "es_tratamiento_de", "Mazorca_Negra,"], [" Corbat", "se_debe_aplicar", "Aplicaci\u00f3n19,"], [" Corbat", "su_dosis_es", "Dosis27"], [" Courage", "is", "Individual"], [" Courage", "Types", "Pesticidas"], [" Courage", "es_tratamiento_de", "Barrenadores,"], [" Courage", "se_debe_aplicar", "Aplicaci\u00f3n2,"], [" Courage", "se_debe_aplicar", "Dosis3"], [" Cyperaceas", "is", "Individual"], [" Cyperaceas", "Types", "Malezas"], [" Cyperaceas", "afecta_a", "Arroz,"], [" Cyperaceas", "su_tratamiento_es", "Rock,"], [" Cyperaceas", "sus_sintomas_son", "Gramalote,"], [" Cyperaceas", "sus_sintomas_son", "Sintoma11,"], [" Cyperaceas", "sus_sintomas_son", "Sintoma12,"], [" Cyperaceas", "descipci\u00f3n", "\"Planta con tallos delgados, glabros, macizos, de secci\u00f3n triangular, de 15-45 cm de altura. \","], [" Cyperaceas", "nombre_cient\u00edfico", "\"Cyperaceae\""], [" Dacapo", "is", "Individual"], [" Dacapo", "Types", "Fungicidas"], [" Dacapo", "es_tratamiento_de", "Moniliasis_del_cacao,"], [" Dacapo", "se_debe_aplicar", "Aplicaci\u00f3n18,"], [" Dacapo", "su_dosis_es", "Dosis3"], [" Daconilc", "is", "Individual"], [" Daconilc", "Types", "Fungicidas"], [" Daconilc", "es_tratamiento_de", "Mancha_de_Hierro,"], [" Daconilc", "se_debe_aplicar", "Aplicaci\u00f3n20,"], [" Daconilc", "su_dosis_es", "Dosis22"], [" Diabolo", "is", "Individual"], [" Diabolo", "Types", "Pesticidas"], [" Diabolo", "es_tratamiento_de", "Chinche_de_la_espiga,"], [" Diabolo", "es_tratamiento_de", "Chinche_del_cacao,"], [" Diabolo", "se_debe_aplicar", "Aplicaci\u00f3n4,"], [" Diabolo", "su_dosis_es", "Dosis5"], [" Difolat\u00e1n", "is", "Individual"], [" Difolat\u00e1n", "Types", "Fungicidas"], [" Difolat\u00e1n", "es_tratamiento_de", "Mancha_de_Hierro,"], [" Difolat\u00e1n", "se_debe_aplicar", "Aplicaci\u00f3n20,"], [" Difolat\u00e1n", "su_dosis_es", "Dosis21"], [" Dimecroa", "is", "Individual"], [" Dimecroa", "Types", "Pesticidas"], [" Dimecroa", "es_sintoma_de", "Escamas,"], [" Dimecroa", "se_debe_aplicar", "Aplicaci\u00f3n3,"], [" Dimecroa", "su_dosis_es", "Dosis16"], [" Dimethoato", "is", "Individual"], [" Dimethoato", "Types", "Pesticidas"], [" Dimethoato", "es_tratamiento_de", "Minador_de_la_hoja,"], [" Dimethoato", "se_debe_aplicar", "Aplicaci\u00f3n16"], [" Dosis1", "is", "Individual"], [" Dosis1", "Types", "Dosis"], [" Dosis1", "es_dosis_de", "Banzai,"], [" Dosis1", "es_dosis_de", "Borey,"], [" Dosis1", "es_dosis_de", "Limpast,"], [" Dosis1", "descipci\u00f3n", "\"0,25 l/ha\""], [" Dosis10", "is", "Individual"], [" Dosis10", "Types", "Dosis"], [" Dosis10", "es_dosis_de", "Metsufozell,"], [" Dosis10", "descipci\u00f3n", "\"5 a 15 g/ha\""], [" Dosis11", "is", "Individual"], [" Dosis11", "Types", "Dosis"], [" Dosis11", "es_dosis_de", "Dimethoato,"], [" Dosis11", "descipci\u00f3n", "\"0,8 - 1,2 ltrs/ha \""], [" Dosis12", "is", "Individual"], [" Dosis12", "Types", "Dosis"], [" Dosis12", "es_dosis_de", "Prelude,"], [" Dosis12", "descipci\u00f3n", "\"100 g/ha\""], [" Dosis13", "is", "Individual"], [" Dosis13", "Types", "Dosis"], [" Dosis13", "es_dosis_de", "Fungis_Khan,"], [" Dosis13", "es_dosis_de", "Lorsban,"], [" Dosis13", "descipci\u00f3n", "\"1,5 kg/ha\""], [" Dosis14", "is", "Individual"], [" Dosis14", "Types", "Dosis"], [" Dosis14", "es_dosis_de", "Nomad,"], [" Dosis14", "descipci\u00f3n", "\"0,3 l/ha\""], [" Dosis15", "is", "Individual"], [" Dosis15", "Types", "Dosis"], [" Dosis15", "es_dosis_de", "Lebaycid,"], [" Dosis15", "descipci\u00f3n", "\"Aplicar 2\""], [" Dosis16", "is", "Individual"], [" Dosis16", "Types", "Dosis"], [" Dosis16", "es_dosis_de", "Basudin,"], [" Dosis16", "es_dosis_de", "Dimecroa,"], [" Dosis16", "descipci\u00f3n", "\"Aplicar 1\""], [" Dosis17", "is", "Individual"], [" Dosis17", "Types", "Dosis"], [" Dosis17", "es_dosis_de", "Furad\u00e1n,"], [" Dosis17", "es_dosis_de", "Temick,"], [" Dosis17", "descipci\u00f3n", "\"5 - 15 gr/hoyo\""], [" Dosis18", "is", "Individual"], [" Dosis18", "Types", "Dosis"], [" Dosis18", "es_dosis_de", "Oxicloruro_de_cobr