, "Courage,"], [" Dosis4", "descipci\u00f3n", "\"0,5 l/ha\""], [" Dosis5", "is", "Individual"], [" Dosis5", "Types", "Dosis"], [" Dosis5", "es_dosis_de", "Diabolo,"], [" Dosis5", "descipci\u00f3n", "\"600 cc/ha\""], [" Dosis6", "is", "Individual"], [" Dosis6", "Types", "Dosis"], [" Dosis6", "es_dosis_de", "Butasol,"], [" Dosis6", "es_dosis_de", "Paroli,"], [" Dosis6", "descipci\u00f3n", "\"3 a 4 l/ha\""], [" Dosis7", "is", "Individual"], [" Dosis7", "Types", "Dosis"], [" Dosis7", "es_dosis_de", "Bacanok,"], [" Dosis7", "descipci\u00f3n", "\"1 a 1,5 l/ha\""], [" Dosis8", "is", "Individual"], [" Dosis8", "Types", "Dosis"], [" Dosis8", "es_dosis_de", "Chekan,"], [" Dosis8", "descipci\u00f3n", "\"100 a 200 cc/ha\""], [" Dosis9", "is", "Individual"], [" Dosis9", "Types", "Dosis"], [" Dosis9", "es_dosis_de", "Rock,"], [" Dosis9", "descipci\u00f3n", "\"350 g/ha\""], [" Escamas", "is", "Individual"], [" Escamas", "Types", "Plagas"], [" Escamas", "afecta_a", "Caf\u00e9,"], [" Escamas", "su_tratamiento_es", "Basudin,"], [" Escamas", "su_tratamiento_es", "Dimecroa,"], [" Escamas", "su_tratamiento_es", "Lebaycid,"], [" Escamas", "sus_sintomas_son", "Sintoma5,"], [" Escamas", "descipci\u00f3n", "\"Estas escamas se localizan en la base del tallo y en la ra\u00edz principal del \u00e1rbol, succiona savia y causa clorosis, defoliaci\u00f3n y, en algunas ocasiones, la muerte de la planta. \","], [" Escamas", "nombre_cient\u00edfico", "\"Coccus viridis Green\""], [" Escoba_de_bruja", "is", "Individual"], [" Escoba_de_bruja", "Types", "Enfermedades"], [" Escoba_de_bruja", "afecta_a", "Cacao,"], [" Escoba_de_bruja", "su_tratamiento_es", "Prelude,"], [" Escoba_de_bruja", "sus_sintomas_son", "Sintoma26,"], [" Escoba_de_bruja", "descipci\u00f3n", "\"El ataque de esta enfermedad es m\u00e1s severo en frutos de tres meses, el ataque en frutos m\u00e1s desarrollados presenta manchas negras da\u00f1ando totalmente sus almendras.\","], [" Escoba_de_bruja", "nombre_cient\u00edfico", "\"Crinipellis perniciosa \""], [" Fungis_Khan", "is", "Individual"], [" Fungis_Khan", "Types", "Fungicidas"], [" Fungis_Khan", "es_tratamiento_de", "Complejo_manchado_del_grano,"], [" Fungis_Khan", "se_debe_aplicar", "Aplicaci\u00f3n12,"], [" Fungis_Khan", "su_dosis_es", "Dosis13"], [" Furad\u00e1n", "is", "Individual"], [" Furad\u00e1n", "Types", "Pesticidas"], [" Furad\u00e1n", "es_tratamiento_de", "Nematodo,"], [" Furad\u00e1n", "su_dosis_es", "Dosis17"], [" Gramalote", "is", "Individual"], [" Gramalote", "Types", "Malezas"], [" Gramalote", "afecta_a", "Cacao,"], [" Gramalote", "afecta_a", "Caf\u00e9,"], [" Gramalote", "su_tratamiento_es", "Ausato,"], [" Gramalote", "descipci\u00f3n", "\"Es un arbusto muy ramificado, que se presenta de variadas formas desde macollas compactas de 1-2 m de altura hasta enredaderas trepadoras de hasta 8 m de altura\","], [" Gramalote", "nombre_cient\u00edfico", "\"Paspalum faciculatum\""], [" Gramineas", "is", "Individual"], [" Gramineas", "Types", "Malezas"], [" Gramineas", "afecta_a", "Arroz,"], [" Gramineas", "afecta_a", "Caf\u00e9,"], [" Gramineas", "su_tratamiento_es", "Bacanok,"], [" Gramineas", "su_tratamiento_es", "Chekan,"], [" Gramineas", "sus_sintomas_son", "Sintoma11,"], [" Gramineas", "sus_sintomas_son", "Sintoma12,"], [" Gramineas", "descipci\u00f3n", "\"Planta herb\u00e1cea, baja, de h\u00e1bito rastrero. \","], [" Gramineas", "nombre_cient\u00edfico", "\"Poaceae\""], [" Guarda_rocio", "is", "Individual"], [" Guarda_rocio", "Types", "Malezas"], [" Guarda_rocio", "afecta_a", "Cacao,"], [" Guarda_rocio", "afecta_a", "Caf\u00e9,"], [" Guarda_rocio", "su_tratamiento_es", "Ausato,"], [" Guarda_rocio", "sus_sintomas_son", "Sintoma12,"], [" Guarda_rocio", "descipci\u00f3n", "\"Es un arbusto leguminoso, de hasta 6 m de altura, que se encuentra en lugares h\u00famedos y abiertos en los tr\u00f3picos. \","], [" Guarda_rocio", "nombre_cient\u00edfico", "\"Digitaria sanguinaris\""], [" Gusano_defoliador", "is", "Individual"], [" Gusano_defoliador", "Types", "Plagas"], [" Gusano_defoliador", "afecta_a", "Cacao,"], [" Gusano_defoliador", "su_tratamiento_es", "Courage,"], [" Gusano_defoliador", "sus_sintomas_son", "Sintoma23,"], [" Gusano_defoliador", "descipci\u00f3n", "\"Es una plaga que ataca hojas y frutos. El da\u00f1o m\u00e1s importante se genera en el follaje pues raspan las hojas las cuales se amarillean y caen, si el ataque es intenso se puede producir una defoliaci\u00f3n constante y progresiva de la planta.\","], [" Gusano_defoliador", "nombre_cient\u00edfico", "\"Stenoma cecropia\""], [" Hidroxido_de_cobre", "is", "Individual"], [" Hidroxido_de_cobre", "Types", "Fungicidas"], [" Hidroxido_de_cobre", "es_tratamiento_de", "La_roya,"], [" Hidroxido_de_cobre", "se_debe_aplicar", "Aplicaci\u00f3n20,"], [" Hidroxido_de_cobre", "su_dosis_es", "Dosis19"], [" Hoja_ancha", "is", "Individual"], [" Hoja_ancha", "Types", "Malezas"], [" Hoja_ancha", "afecta_a", "Arroz,"], [" Hoja_ancha", "su_tratamiento_es", "Limpast,"], [" Hoja_ancha", "su_tratamiento_es", "Metsufozell,"], [" Hoja_ancha", "descipci\u00f3n", "\"Es una maleza perenne persistente, que se propaga radialmente, produciendo hasta 25 o m\u00e1s tallos en una temporada, muchos de los cuales pueden alcanzar hasta 3 m de longitud, formando un manto denso sobre el suelo. \","], [" Hoja_ancha", "nombre_cient\u00edfico", "\"Hoja ancha\""], [" Hoja_angosta", "is", "Individual"], [" Hoja_angosta", "Types", "Malezas"], [" Hoja_angosta", "afecta_a", "Arroz,"], [" Hoja_angosta", "su_tratamiento_es", "Butasol,"], [" Hoja_angosta", "su_tratamiento_es", "Paroli,"], [" Hoja_angosta", "sus_sintomas_son", "Sintoma11,"], [" Hoja_angosta", "descipci\u00f3n", "\"Es un arbusto perenne abierto que crece hasta una altura de 5 m cuando cuenta con un soporte."], [" Hoja_angosta", "Crece en muchos tipos de suelos, pero prefiere los bien drenados. No tolera la sombra y prospera bien en \u00e1reas abiertas. \",", "\"Hoja angosta\""], [" Hoja_angosta", "nombre_cient\u00edfico", "\"Hoja angosta\""], [" Hormiga_Azteca", "is", "Individual"], [" Hormiga_Azteca", "Types", "Plagas"], [" Hormiga_Azteca", "afecta_a", "Cacao,"], [" Hormiga_Azteca", "su_tratamiento_es", "Borey,"], [" Hormiga_Azteca", "sus_sintomas_son", "Sintoma24,"], [" Hormiga_Azteca", "sus_sintomas_son", "Sintoma25,"], [" Hormiga_Azteca", "descipci\u00f3n", "\"Son una de las plagas m\u00e1s comunes"], [" Hormiga_Azteca", "nombre_cient\u00edfico", "\"Azteca paraensis bondari"], [" La_roya", "is", "Individual"], [" La_roya", "Types", "Enfermedades"], [" La_roya", "afecta_a", "Caf\u00e9,"], [" La_roya", "su_tratamiento_es", "Caldo_Bord\u00e9s,"], [" La_roya", "su_tratamiento_es", "Oxicloruro_de_cobre,"], [" La_roya", "sus_sintomas_son", "Sintoma1,"], [" La_roya", "sus_sintomas_son", "Sintoma17,"], [" La_roya", "descipci\u00f3n", "\"La roya del cafeto es la enfermedad m\u00e1s destructiva del cafeto y la de mayor importancia econ\u00f3mica a nivel mundial, debido a que esta enfermedad provoca la ca\u00edda prematura de las hojas, propiciando la reducci\u00f3n de la capacidad fotosint\u00e9tica\","], [" La_roya", "nombre_cient\u00edfico", "\"La Roya\""], [" Langosta", "is", "Individual"], [" Langosta", "Types", "Plagas"], [" Langosta", "afecta_a", "Arroz,"], [" Langosta", "su_tratamiento_es", "Courage,"], [" Langosta", "sus_sintomas_son", "Gramalote,"], [" Langosta", "sus_sintomas_son", "Sintoma3,"], [" Langosta", "descipci\u00f3n", "\"Esta plaga provoca da\u00f1os durante todo el proceso de crecimiento, ataca el cultivo representando grandes peligros como el impedimento de rebrote.\","], [" Langosta", "nombre_cient\u00edfico", "\"Spodoptera frugiperda\""], [" Lebaycid", "is", "Individual"], [" Lebaycid", "Types", "Pesticidas"], [" Lebaycid", "es_tratamiento_de", "Escamas,"], [" Lebaycid", "se_debe_aplicar", "Aplicaci\u00f3n3,"], [" Lebaycid", "su_dosis_es", "Dosis15"], [" Lechosa", "is", "Individual"], [" Lechosa", "Types", "Malezas"], [" Lechosa", "afecta_a", "Cacao,"], [" Lec